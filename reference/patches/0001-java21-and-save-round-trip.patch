+package net.blerf.ftl.tools;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.nio.file.Files;
+
+import net.blerf.ftl.parser.DataManager;
+import net.blerf.ftl.parser.DefaultDataManager;
+import net.blerf.ftl.parser.SavedGameParser;
+import net.blerf.ftl.parser.SavedGameParser.SavedGameState;
+
+
+/**
+ * Reads a saved game, writes it back to memory and compares the bytes.
+ *
+ * Usage: java -cp FTLProfileEditor.jar net.blerf.ftl.tools.SaveRoundTrip DATS_DIR SAV_FILE [OUT_FILE]
+ *
+ * DATS_DIR is the folder that holds ftl.dat (on macOS: FTL.app/Contents/Resources).
+ * Exit 0: the written bytes equal the input. Exit 1: they differ; the first
+ * differing offset is printed and, with OUT_FILE, the written bytes are saved.
+ * Exit 2: usage or read error. The input file is never modified.
+ */
+public class SaveRoundTrip {
+
+	public static void main( String[] args ) throws Exception {
+		if ( args.length < 2 ) {
+			System.err.println( "Usage: SaveRoundTrip DATS_DIR SAV_FILE [OUT_FILE]" );
+			System.exit( 2 );
+		}
+		File datsDir = new File( args[0] );
+		File savFile = new File( args[1] );
+
+		DefaultDataManager dataManager = new DefaultDataManager( datsDir );
+		dataManager.setDLCEnabledByDefault( true );  // Same as the GUI: AE ships live in dlcBlueprints.xml.
+		DataManager.setInstance( dataManager );
+
+		byte[] original = Files.readAllBytes( savFile.toPath() );
+
+		SavedGameParser parser = new SavedGameParser();
+		SavedGameState state = parser.readSavedGame( savFile );
+		System.out.println( "fileFormat="+ state.getFileFormat() +" ship="+ state.getPlayerShipName() +" sector="+ (state.getSectorNumber()+1) );
+		System.out.println( "scrap="+ state.getPlayerShip().getScrapAmt() +" fuel="+ state.getPlayerShip().getFuelAmt() +" missiles="+ state.getPlayerShip().getMissilesAmt() +" droneParts="+ state.getPlayerShip().getDronePartsAmt() +" hull="+ state.getPlayerShip().getHullAmt() );
+
+		ByteArrayOutputStream out = new ByteArrayOutputStream();
+		parser.writeSavedGame( out, state );
+		byte[] written = out.toByteArray();
+
+		if ( args.length >= 3 ) {
+			Files.write( new File( args[2] ).toPath(), written );
+		}
+
+		int n = Math.min( original.length, written.length );
+		for ( int i=0; i < n; i++ ) {
+			if ( original[i] != written[i] ) {
+				System.out.println( String.format( "DIFFER at offset %d (0x%X): original=%d written=%d, sizes %d/%d", i, i, original[i], written[i], original.length, written.length ) );
+				System.exit( 1 );
+			}
+		}
+		if ( original.length != written.length ) {
+			System.out.println( String.format( "DIFFER in size: original=%d written=%d", original.length, written.length ) );
+			System.exit( 1 );
+		}
+		System.out.println( "IDENTICAL: "+ original.length +" bytes" );
+	}
+}
